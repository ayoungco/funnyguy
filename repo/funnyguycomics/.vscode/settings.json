{
  "window.title": "Funny Guy Comics - ${activeEditorShort}",
  "workbench.colorTheme": "Light Modern",
  "workbench.editor.labelFormat": "medium",
  "workbench.tree.indent": 16,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.rulers": [
    88
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "public/": true,
    "panel-output/": true,
    "video-output/": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.typeCheckingMode": "basic",
  "ruff.lineLength": 88,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "terminal.integrated.tabs.title": "FGC",
  "workbench.colorCustomizations": {
    "activityBar.background": "#b21a1a",
    "activityBar.foreground": "#fff8ef",
    "activityBar.inactiveForeground": "#f4c7ba",
    "activityBarBadge.background": "#1d1b1b",
    "activityBarBadge.foreground": "#fff8ef",
    "badge.background": "#b21a1a",
    "badge.foreground": "#fff8ef",
    "button.background": "#b21a1a",
    "button.foreground": "#fff8ef",
    "button.hoverBackground": "#8f1414",
    "editor.background": "#fffaf1",
    "editor.foreground": "#1d1b1b",
    "editorCursor.foreground": "#b21a1a",
    "editorLineNumber.activeForeground": "#b21a1a",
    "editorLineNumber.foreground": "#9a867d",
    "editor.selectionBackground": "#f5d1c2",
    "editor.wordHighlightBackground": "#ffe6a755",
    "editorBracketMatch.background": "#f5d1c2",
    "editorBracketMatch.border": "#b21a1a",
    "editorGroupHeader.tabsBackground": "#f3ede3",
    "editorIndentGuide.activeBackground1": "#b21a1a80",
    "editorIndentGuide.background1": "#d8c9bc",
    "input.background": "#fffaf1",
    "input.border": "#d8c9bc",
    "input.foreground": "#1d1b1b",
    "list.activeSelectionBackground": "#f5d1c2",
    "list.activeSelectionForeground": "#1d1b1b",
    "list.hoverBackground": "#fff0e8",
    "menu.background": "#87ceeb",
    "menu.foreground": "#1d1b1b",
    "menu.selectionBackground": "#bfefff",
    "menu.selectionForeground": "#1d1b1b",
    "menu.separatorBackground": "#5aaed0",
    "menubar.selectionBackground": "#87ceeb",
    "menubar.selectionForeground": "#1d1b1b",
    "panel.background": "#f8f5ef",
    "panel.border": "#d8c9bc",
    "sideBar.background": "#f8f5ef",
    "sideBar.foreground": "#1d1b1b",
    "sideBarSectionHeader.background": "#eee4d7",
    "statusBar.background": "#1d1b1b",
    "statusBar.foreground": "#fff8ef",
    "statusBarItem.remoteBackground": "#b21a1a",
    "tab.activeBackground": "#fffaf1",
    "tab.activeForeground": "#b21a1a",
    "tab.border": "#d8c9bc",
    "tab.inactiveBackground": "#f3ede3",
    "tab.inactiveForeground": "#5c504b",
    "terminal.background": "#1d1b1b",
    "terminal.foreground": "#f8f5ef",
    "terminal.ansiBrightRed": "#ff5c4d",
    "terminal.ansiRed": "#b21a1a",
    "titleBar.activeBackground": "#b21a1a",
    "titleBar.activeForeground": "#fff8ef",
    "titleBar.inactiveBackground": "#8f1414",
    "titleBar.inactiveForeground": "#f4c7ba"
  }
}
