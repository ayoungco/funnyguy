#ErrorDocument 404 /404.php

RewriteEngine on

RewriteCond %{HTTP_HOST} ^[^.]+\.[^.]+$
RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [L,R=301]

RewriteRule ^([0-9]+)/([0-9]+)/?$ index.php?number=$1&page=$2 [L]
RewriteRule ^([0-9]+)/?$ index.php?number=$1 [L]
RewriteRule ^history/?$ history.php
RewriteRule ^random/?$ random.php
RewriteRule ^extras/?$ extras.php
RewriteRule ^archive/?$ archive.php
RewriteRule ^game/?$ game.php
